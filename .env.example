# Base de données (Vercel + Neon) et fichiers (Vercel Blob) : `vercel env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=

# Comptes du personnel (Clerk, via Vercel Marketplace)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/espace/connexion
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/espace
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/espace/connexion
# Adresses toujours administratrices (séparées par des virgules)
ADMIN_EMAILS=

# E-mails (Resend) — optionnel : sans clé, aucun e-mail n'est envoyé
RESEND_API_KEY=
EMAIL_FROM="Église Adventiste Philadelphie <no-reply@philadelphiesdachurch.com>"

# Adresse publique du site (liens dans les e-mails, sitemap)
NEXT_PUBLIC_SITE_URL=https://philadelphiesdachurch.com

# Écran TV sans connexion (mode kiosque) — optionnel.
# Si défini, /espace/comptage/ecran?k=<jeton> s'ouvre sans compte ; la page Comptage affiche le lien à copier.
# Choisir une longue chaîne aléatoire, p. ex. `openssl rand -hex 24`.
SCREEN_TOKEN=

# Clôture automatique du comptage (Vercel Cron, vercel.json). Vercel envoie ce secret
# dans l'en-tête Authorization de /api/cron/cloture ; sans lui la route refuse tout (401).
CRON_SECRET=

# Chaîne YouTube (derniers cultes et direct) — optionnel.
# Sans clé, le site lit la chaîne par son flux et ses pages ; avec une clé API YouTube Data v3
# (console Google Cloud → APIs & Services → Credentials), la lecture passe par l'API, plus fiable.
YOUTUBE_API_KEY=
